<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Journal Trade — Infrastructure Architecture</title>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'JetBrains Mono', monospace;
      background: #020617;
      min-height: 100vh;
      padding: 2rem;
      color: white;
    }
    .container { max-width: 1400px; margin: 0 auto; }
    .header { margin-bottom: 2rem; }
    .header-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
    .pulse-dot { width: 12px; height: 12px; background: #22d3ee; border-radius: 50%; animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.025em; }
    .subtitle { color: #94a3b8; font-size: 0.875rem; margin-left: 1.75rem; }
    .diagram-container {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 1rem;
      border: 1px solid #1e293b;
      padding: 1.5rem;
      overflow-x: auto;
    }
    svg { width: 100%; min-width: 1300px; display: block; }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }
    .card {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 0.75rem;
      border: 1px solid #1e293b;
      padding: 1.25rem;
    }
    .card-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .card-dot { width: 8px; height: 8px; border-radius: 50%; }
    .card-dot.cyan { background: #22d3ee; }
    .card-dot.emerald { background: #34d399; }
    .card-dot.violet { background: #a78bfa; }
    .card-dot.amber { background: #fbbf24; }
    .card-dot.rose { background: #fb7185; }
    .card-dot.orange { background: #fb923c; }
    .card h3 { font-size: 0.875rem; font-weight: 600; }
    .card ul { list-style: none; color: #94a3b8; font-size: 0.75rem; }
    .card li { margin-bottom: 0.375rem; }
    .footer { text-align: center; margin-top: 1.5rem; color: #475569; font-size: 0.75rem; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="header-row">
        <div class="pulse-dot"></div>
        <h1>Journal Trade — Infrastructure Architecture</h1>
      </div>
      <p class="subtitle">ML Inference · PostgreSQL · Celery Workers · Redis Cache · MT5 Gateway · LLM Consensus</p>
    </div>

    <div class="diagram-container">
      <svg viewBox="0 0 1400 1050">
        <defs>
          <marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#64748b" />
          </marker>
          <marker id="arrow-cyan" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#22d3ee" />
          </marker>
          <marker id="arrow-emerald" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#34d399" />
          </marker>
          <marker id="arrow-violet" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#a78bfa" />
          </marker>
          <marker id="arrow-amber" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#fbbf24" />
          </marker>
          <marker id="arrow-rose" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#fb7185" />
          </marker>
          <marker id="arrow-orange" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" fill="#fb923c" />
          </marker>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1e293b" stroke-width="0.5"/>
          </pattern>
        </defs>

        <rect width="100%" height="100%" fill="url(#grid)" />

        <!-- ============================================================
             LAYER BOUNDARIES
             ============================================================ -->

        <!-- Layer 1: Client / External -->
        <rect x="20" y="20" width="1360" height="100" rx="12" fill="rgba(8, 51, 68, 0.08)" stroke="#22d3ee" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="38" fill="#22d3ee" font-size="10" font-weight="600">LAYER 1 — CLIENT / EXTERNAL</text>

        <!-- Layer 2: API Gateway / Load Balancer -->
        <rect x="20" y="140" width="1360" height="110" rx="12" fill="rgba(120, 53, 15, 0.06)" stroke="#fbbf24" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="158" fill="#fbbf24" font-size="10" font-weight="600">LAYER 2 — GATEWAY / REVERSE PROXY</text>

        <!-- Layer 3: Application Services -->
        <rect x="20" y="270" width="1360" height="260" rx="12" fill="rgba(6, 78, 59, 0.06)" stroke="#34d399" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="288" fill="#34d399" font-size="10" font-weight="600">LAYER 3 — APPLICATION SERVICES</text>

        <!-- Layer 4: ML Inference -->
        <rect x="20" y="550" width="1360" height="130" rx="12" fill="rgba(168, 85, 247, 0.06)" stroke="#a78bfa" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="568" fill="#a78bfa" font-size="10" font-weight="600">LAYER 4 — ML INFERENCE / AI CONSENSUS</text>

        <!-- Layer 5: Data & Cache -->
        <rect x="20" y="700" width="1360" height="130" rx="12" fill="rgba(251, 146, 60, 0.06)" stroke="#fb923c" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="718" fill="#fb923c" font-size="10" font-weight="600">LAYER 5 — DATA STORE / CACHE / QUEUE</text>

        <!-- Layer 6: External Trading -->
        <rect x="20" y="850" width="1360" height="100" rx="12" fill="rgba(136, 19, 55, 0.06)" stroke="#fb7185" stroke-width="1" stroke-dasharray="8,4"/>
        <text x="32" y="868" fill="#fb7185" font-size="10" font-weight="600">LAYER 6 — EXTERNAL TRADING / MARKET DATA</text>

        <!-- ============================================================
             ARROWS (drawn early for z-order behind boxes)
             ============================================================ -->

        <!-- Nginx -> Next.js -->
        <line x1="250" y1="195" x2="250" y2="310" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#arrow-cyan)"/>
        <text x="260" y="250" fill="#94a3b8" font-size="8">HTTP :3000</text>

        <!-- Nginx -> Express -->
        <line x1="500" y1="195" x2="500" y2="310" stroke="#34d399" stroke-width="1.5" marker-end="url(#arrow-emerald)"/>
        <text x="510" y="250" fill="#94a3b8" font-size="8">API :5000</text>

        <!-- Express -> Redis -->
        <line x1="500" y1="440" x2="500" y2="730" stroke="#fb923c" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#arrow-orange)"/>
        <text x="510" y="580" fill="#fb923c" font-size="8">cache / pub-sub</text>

        <!-- Express -> PostgreSQL -->
        <line x1="580" y1="440" x2="680" y2="730" stroke="#a78bfa" stroke-width="1.5" marker-end="url(#arrow-violet)"/>
        <text x="620" y="580" fill="#a78bfa" font-size="8">Drizzle ORM</text>

        <!-- Express -> MongoDB -->
        <line x1="460" y1="440" x2="320" y2="730" stroke="#fbbf24" stroke-width="1.5" marker-end="url(#arrow-amber)"/>
        <text x="360" y="580" fill="#fbbf24" font-size="8">Mongoose</text>

        <!-- Express -> Celery (task dispatch) -->
        <line x1="700" y1="440" x2="800" y2="730" stroke="#fb923c" stroke-width="1.5" marker-end="url(#arrow-orange)"/>
        <text x="740" y="575" fill="#fb923c" font-size="8">enqueue tasks</text>

        <!-- Celery -> Redis (broker) -->
        <line x1="900" y1="760" x2="540" y2="760" stroke="#fb923c" stroke-width="1.5" marker-end="url(#arrow-orange)"/>
        <text x="720" y="750" fill="#fb923c" font-size="8">Celery Broker (Redis)</text>

        <!-- Celery Workers -> ML Inference -->
        <line x1="860" y1="690" x2="860" y2="630" stroke="#a78bfa" stroke-width="1.5" marker-end="url(#arrow-violet)"/>
        <text x="870" y="660" fill="#a78bfa" font-size="8">run inference</text>

        <!-- 9Router -> ML providers -->
        <line x1="300" y1="625" x2="300" y2="690" stroke="#fb7185" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#arrow-rose)"/>
        <text x="310" y="658" fill="#fb7185" font-size="8">multi-model</text>

        <!-- MT5 MCP -> MT5 Terminal -->
        <line x1="1200" y1="440" x2="1200" y2="890" stroke="#fb7185" stroke-width="1.5" marker-end="url(#arrow-rose)"/>
        <text x="1210" y="660" fill="#fb7185" font-size="8">MCP stdio</text>

        <!-- MT5 MCP -> PostgreSQL -->
        <line x1="1130" y1="440" x2="760" y2="730" stroke="#a78bfa" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow-violet)"/>
        <text x="920" y="575" fill="#94a3b8" font-size="7">log trades</text>

        <!-- ============================================================
             LAYER 1 COMPONENTS — Client / External
             ============================================================ -->

        <!-- User Browser -->
        <rect x="180" y="50" width="140" height="55" rx="6" fill="rgba(8, 51, 68, 0.4)" stroke="#22d3ee" stroke-width="1.5"/>
        <text x="250" y="73" fill="white" font-size="11" font-weight="600" text-anchor="middle">User Browser</text>
        <text x="250" y="89" fill="#94a3b8" font-size="9" text-anchor="middle">Next.js SSR + App Router</text>

        <!-- Telegram Bot (optional) -->
        <rect x="420" y="50" width="140" height="55" rx="6" fill="rgba(8, 51, 68, 0.4)" stroke="#22d3ee" stroke-width="1.5"/>
        <text x="490" y="73" fill="white" font-size="11" font-weight="600" text-anchor="middle">Telegram Alerts</text>
        <text x="490" y="89" fill="#94a3b8" font-size="9" text-anchor="middle">Trade notifications</text>

        <!-- Discord Auth -->
        <rect x="660" y="50" width="140" height="55" rx="6" fill="rgba(136, 19, 55, 0.4)" stroke="#fb7185" stroke-width="1.5"/>
        <text x="730" y="73" fill="white" font-size="11" font-weight="600" text-anchor="middle">Discord OAuth</text>
        <text x="730" y="89" fill="#94a3b8" font-size="9" text-anchor="middle">Better Auth provider</text>

        <!-- ============================================================
             LAYER 2 COMPONENTS — Gateway
             ============================================================ -->

        <!-- Nginx -->
        <rect x="350" y="165" width="300" height="60" rx="8" fill="rgba(120, 53, 15, 0.3)" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="500" y="188" fill="white" font-size="12" font-weight="600" text-anchor="middle">Nginx Reverse Proxy</text>
        <text x="500" y="205" fill="#94a3b8" font-size="9" text-anchor="middle">SSL termination · /api/* → :5000 · / → :3000</text>

        <!-- ============================================================
             LAYER 3 COMPONENTS — Application Services
             ============================================================ -->

        <!-- Next.js Frontend -->
        <rect x="180" y="310" width="140" height="120" rx="6" fill="rgba(8, 51, 68, 0.4)" stroke="#22d3ee" stroke-width="1.5"/>
        <text x="250" y="333" fill="white" font-size="11" font-weight="600" text-anchor="middle">Next.js 16</text>
        <text x="250" y="349" fill="#94a3b8" font-size="8" text-anchor="middle">Turbopack</text>
        <text x="250" y="364" fill="#94a3b8" font-size="8" text-anchor="middle">App Router :3000</text>
        <text x="250" y="384" fill="#94a3b8" font-size="8" text-anchor="middle">── Components ──</text>
        <text x="250" y="398" fill="#94a3b8" font-size="8" text-anchor="middle">TradingPanel</text>
        <text x="250" y="412" fill="#94a3b8" font-size="8" text-anchor="middle">BacktestStream</text>
        <text x="250" y="426" fill="#94a3b8" font-size="8" text-anchor="middle">PositionTable</text>

        <!-- Express Backend -->
        <rect x="380" y="310" width="240" height="120" rx="6" fill="rgba(6, 78, 59, 0.4)" stroke="#34d399" stroke-width="1.5"/>
        <text x="500" y="333" fill="white" font-size="11" font-weight="600" text-anchor="middle">Express + TypeScript</text>
        <text x="500" y="349" fill="#94a3b8" font-size="8" text-anchor="middle">API Server :5000</text>
        <text x="500" y="369" fill="#94a3b8" font-size="8" text-anchor="middle">── Services (40+) ──</text>
        <text x="500" y="383" fill="#94a3b8" font-size="8" text-anchor="middle">TradingPipeline · RiskManager</text>
        <text x="500" y="397" fill="#94d399" font-size="8" text-anchor="middle">AI-Backtest · WalkForward</text>
        <text x="500" y="411" fill="#94a3b8" font-size="8" text-anchor="middle">AutonomousMode · MarketRegime</text>
        <text x="500" y="425" fill="#94a3b8" font-size="8" text-anchor="middle">NewsCalendar · Fundamental</text>

        <!-- MT5 MCP Server (Python) -->
        <rect x="1070" y="310" width="180" height="120" rx="6" fill="rgba(136, 19, 55, 0.4)" stroke="#fb7185" stroke-width="1.5"/>
        <text x="1160" y="333" fill="white" font-size="11" font-weight="600" text-anchor="middle">MT5 MCP Server</text>
        <text x="1160" y="349" fill="#94a3b8" font-size="8" text-anchor="middle">Python · trade_api.py</text>
        <text x="1160" y="369" fill="#94a3b8" font-size="8" text-anchor="middle">── Actions ──</text>
        <text x="1160" y="383" fill="#94a3b8" font-size="8" text-anchor="middle">order_send · position_close</text>
        <text x="1160" y="397" fill="#94a3b8" font-size="8" text-anchor="middle">position_modify · positions_get</text>
        <text x="1160" y="411" fill="#94a3b8" font-size="8" text-anchor="middle">AES-256-CBC cred encryption</text>
        <text x="1160" y="425" fill="#fb7185" font-size="7" text-anchor="middle">Single-process MT5 connection</text>

        <!-- 9Router LLM Gateway -->
        <rect x="660" y="310" width="180" height="120" rx="6" fill="rgba(6, 78, 59, 0.4)" stroke="#34d399" stroke-width="1.5"/>
        <text x="750" y="333" fill="white" font-size="11" font-weight="600" text-anchor="middle">9Router Gateway</text>
        <text x="750" y="349" fill="#94a3b8" font-size="8" text-anchor="middle">LLM Proxy :20128</text>
        <text x="750" y="369" fill="#94a3b8" font-size="8" text-anchor="middle">── Routing ──</text>
        <text x="750" y="383" fill="#94a3b8" font-size="8" text-anchor="middle">Claude · Gemini · Groq</text>
        <text x="750" y="397" fill="#94a3b8" font-size="8" text-anchor="middle">DashScope · OpenRouter</text>
        <text x="750" y="411" fill="#34d399" font-size="8" text-anchor="middle">≥50% consensus to execute</text>
        <text x="750" y="425" fill="#94a3b8" font-size="7" text-anchor="middle">8s timeout per provider</text>

        <!-- Strategy Engine -->
        <rect x="880" y="310" width="160" height="120" rx="6" fill="rgba(6, 78, 59, 0.4)" stroke="#34d399" stroke-width="1.5"/>
        <text x="960" y="333" fill="white" font-size="11" font-weight="600" text-anchor="middle">Strategy Engine</text>
        <text x="960" y="349" fill="#94a3b8" font-size="8" text-anchor="middle">7 Methodologies</text>
        <text x="960" y="369" fill="#94a3b8" font-size="8" text-anchor="middle">── Modules ──</text>
        <text x="960" y="383" fill="#94a3b8" font-size="8" text-anchor="middle">SMC · ICT · MSNR · CRT</text>
        <text x="960" y="397" fill="#94a3b8" font-size="8" text-anchor="middle">LIT · Quarterly · MktStruct</text>
        <text x="960" y="411" fill="#34d399" font-size="8" text-anchor="middle">Confluence Engine</text>
        <text x="960" y="425" fill="#94a3b8" font-size="7" text-anchor="middle">Weighted voting → Signal</text>

        <!-- ============================================================
             LAYER 4 COMPONENTS — ML Inference
             ============================================================ -->

        <!-- ML Inference Service -->
        <rect x="140" y="580" width="320" height="85" rx="6" fill="rgba(168, 85, 247, 0.4)" stroke="#a78bfa" stroke-width="1.5"/>
        <text x="300" y="603" fill="white" font-size="11" font-weight="600" text-anchor="middle">ML Inference Service</text>
        <text x="300" y="620" fill="#94a3b8" font-size="9" text-anchor="middle">LLM Consensus · Trade Journal Analysis</text>
        <text x="300" y="636" fill="#94a3b8" font-size="8" text-anchor="middle">Walk-Forward Optimization · Auto-Backtest Batch</text>
        <text x="300" y="652" fill="#a78bfa" font-size="7" text-anchor="middle">Calls 9Router / external LLM providers</text>

        <!-- Celery Workers -->
        <rect x="800" y="580" width="200" height="85" rx="6" fill="rgba(251, 146, 60, 0.4)" stroke="#fb923c" stroke-width="1.5"/>
        <text x="900" y="603" fill="white" font-size="11" font-weight="600" text-anchor="middle">Celery Workers</text>
        <text x="900" y="620" fill="#94a3b8" font-size="9" text-anchor="middle">Background job execution</text>
        <text x="900" y="636" fill="#94a3b8" font-size="8" text-anchor="middle">── Task Types ──</text>
        <text x="900" y="652" fill="#fb923c" font-size="8" text-anchor="middle">backtest · inference · sync · journal</text>

        <!-- Celery Beat (Scheduler) -->
        <rect x="1050" y="580" width="140" height="85" rx="6" fill="rgba(251, 146, 60, 0.3)" stroke="#fb923c" stroke-width="1.5" stroke-dasharray="4,3"/>
        <text x="1120" y="603" fill="white" font-size="11" font-weight="600" text-anchor="middle">Celery Beat</text>
        <text x="1120" y="620" fill="#94a3b8" font-size="9" text-anchor="middle">Periodic scheduler</text>
        <text x="1120" y="636" fill="#94a3b8" font-size="8" text-anchor="middle">── Cron Jobs ──</text>
        <text x="1120" y="652" fill="#fb923c" font-size="8" text-anchor="middle">auto-backtest · skill update</text>

        <!-- ============================================================
             LAYER 5 COMPONENTS — Data / Cache / Queue
             ============================================================ -->

        <!-- MongoDB -->
        <rect x="200" y="730" width="180" height="80" rx="6" fill="rgba(120, 53, 15, 0.3)" stroke="#fbbf24" stroke-width="1.5"/>
        <text x="290" y="753" fill="white" font-size="11" font-weight="600" text-anchor="middle">MongoDB</text>
        <text x="290" y="769" fill="#94a3b8" font-size="9" text-anchor="middle">Mongoose ODM</text>
        <text x="290" y="785" fill="#fbbf24" font-size="8" text-anchor="middle">15 collections</text>
        <text x="290" y="800" fill="#94a3b8" font-size="7" text-anchor="middle">users · trade_logs · sessions · skills</text>

        <!-- PostgreSQL -->
        <rect x="620" y="730" width="180" height="80" rx="6" fill="rgba(76, 29, 149, 0.4)" stroke="#a78bfa" stroke-width="1.5"/>
        <text x="710" y="753" fill="white" font-size="11" font-weight="600" text-anchor="middle">PostgreSQL</text>
        <text x="710" y="769" fill="#94a3b8" font-size="9" text-anchor="middle">Drizzle ORM</text>
        <text x="710" y="785" fill="#a78bfa" font-size="8" text-anchor="middle">Migrations ready</text>
        <text x="710" y="800" fill="#94a3b8" font-size="7" text-anchor="middle">Structured data · Analytics</text>

        <!-- Redis -->
        <rect x="420" y="730" width="180" height="80" rx="6" fill="rgba(251, 146, 60, 0.3)" stroke="#fb923c" stroke-width="1.5"/>
        <text x="510" y="753" fill="white" font-size="11" font-weight="600" text-anchor="middle">Redis</text>
        <text x="510" y="769" fill="#94a3b8" font-size="9" text-anchor="middle">Cache + Message Broker</text>
        <text x="510" y="785" fill="#fb923c" font-size="8" text-anchor="middle">── 3 Roles ──</text>
        <text x="510" y="800" fill="#94a3b8" font-size="7" text-anchor="middle">Cache · Celery Broker · Pub-Sub</text>

        <!-- ============================================================
             LAYER 6 COMPONENTS — External Trading
             ============================================================ -->

        <!-- MT5 Terminal -->
        <rect x="1100" y="880" width="180" height="55" rx="6" fill="rgba(136, 19, 55, 0.4)" stroke="#fb7185" stroke-width="1.5"/>
        <text x="1190" y="903" fill="white" font-size="11" font-weight="600" text-anchor="middle">MT5 Terminal</text>
        <text x="1190" y="919" fill="#fb7185" font-size="8" text-anchor="middle">Single connection · Windows</text>

        <!-- Market Data APIs -->
        <rect x="200" y="880" width="140" height="55" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="270" y="903" fill="white" font-size="10" font-weight="600" text-anchor="middle">Finnhub</text>
        <text x="270" y="919" fill="#94a3b8" font-size="8" text-anchor="middle">Quotes · News · Indicators</text>

        <rect x="370" y="880" width="140" height="55" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="440" y="903" fill="white" font-size="10" font-weight="600" text-anchor="middle">Alpha Vantage</text>
        <text x="440" y="919" fill="#94a3b8" font-size="8" text-anchor="middle">Economic indicators</text>

        <rect x="540" y="880" width="140" height="55" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="610" y="903" fill="white" font-size="10" font-weight="600" text-anchor="middle">Twelve Data</text>
        <text x="610" y="919" fill="#94a3b8" font-size="8" text-anchor="middle">Market data + calendar</text>

        <rect x="710" y="880" width="120" height="55" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="770" y="903" fill="white" font-size="10" font-weight="600" text-anchor="middle">FRED</text>
        <text x="770" y="919" fill="#94a3b8" font-size="8" text-anchor="middle">Fed economic data</text>

        <rect x="860" y="880" width="170" height="55" rx="6" fill="rgba(30, 41, 59, 0.5)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="945" y="903" fill="white" font-size="10" font-weight="600" text-anchor="middle">Trading Economics</text>
        <text x="945" y="919" fill="#94a3b8" font-size="8" text-anchor="middle">Calendar + indicators</text>

        <!-- ============================================================
             LEGEND
             ============================================================ -->
        <rect x="1080" y="720" width="280" height="95" rx="6" fill="rgba(15, 23, 42, 0.8)" stroke="#1e293b" stroke-width="1"/>
