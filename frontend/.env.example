# Frontend build-time configuration.
#
# Only NEXT_PUBLIC_* values belong here. Next.js inlines NEXT_PUBLIC_* into the
# client bundle at build time, so they are public by definition — never put a
# secret, token or API key in this file.
#
# The packaged desktop app runs the frontend standalone server on port 3000 and
# talks to the backend on port 5000, so these defaults are correct for a
# single-machine install.

NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Widget Workspace (Fase 0) — 'true' mengaktifkan workspace drag/resize
NEXT_PUBLIC_WIDGET_WORKSPACE_ENABLED=false
