{
  "name": "journal-trade",
  "version": "1.2.0",
  "private": true,
  "description": "Hunter Trades — Journal Trade monorepo (server / frontend / desktop)",
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "npm --prefix server run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:desktop": "npm --prefix desktop run build:pack",
    "build:all": "npm run build && npm run build:desktop",
    "mobile:get": "cd mobile && flutter pub get",
    "mobile:l10n": "cd mobile && flutter gen-l10n",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:test": "cd mobile && flutter test",
    "mobile:run": "cd mobile && flutter run",
    "mobile:web": "cd mobile && flutter run -d chrome",
    "mobile:build:web": "cd mobile && flutter build web --release",
    "mobile:build:apk": "cd mobile && flutter build apk --release",
    "test": "npm run test:server && npm run test:frontend",
    "test:server": "npm --prefix server test",
    "test:frontend": "npm --prefix frontend test",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix server run typecheck && npm --prefix frontend run typecheck",
    "preflight": "node scripts/preflight-release.mjs",
    "preflight:bundle": "node scripts/preflight-release.mjs --strict-bundle",
    "check:pins": "node scripts/check-desktop-pins.mjs",
    "build:patch": "npm --prefix desktop run build:patch",
    "release": "npm run build:all && npm run preflight:bundle && npm run build:patch"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
