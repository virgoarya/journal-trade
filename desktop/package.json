{
  "name": "hunter-trades-desktop",
  "version": "1.0.10",
  "description": "Hunter Trades Elite Ledger Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:server": "cd ../server && npx tsc",
    "build:pack": "node buildHooks/buildApp.js",
    "build:win": "node buildHooks/buildApp.js",
    "build:patch": "node buildHooks/buildPatch.js",
    "build:all": "npm run build:frontend && npm run build:server && npm run build:win",
    "release": "npm run build:frontend && npm run build:server && npm run build:win",
    "release:all": "npm run release"
  },
  "author": "Hunter Trades",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "electron-updater": "^6.8.9"
  }
}