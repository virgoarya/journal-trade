    let keyLevelType = "NONE";
    let keyLevelPrice = 0;
    for (const ob of ms.orderBlocks) {
      if (!ob.mitigated && Math.abs(last.close - (htfTrend === "BULL" ? ob.bottom : ob.top)) < (last.high - last.low) * 2) {
