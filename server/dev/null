        atKeyLevel = true;
        keyLevelType = "SWING";
        keyLevelPrice = latestSwingHigh;
      }
    }
    return {
      swingHigh: latestSwingHigh,
      swingLow: latestSwingLow,
      internalStructure,
      atKeyLevel,
      keyLevelType,
      keyLevelPrice
