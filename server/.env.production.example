# ============================================================
# HUNTER TRADES JOURNAL — ENV PRODUCTION
# ============================================================
# Copy ke `.env` di host produksi (ATAU inject via secret manager).
# JANGAN pernah commit file .env berisi nilai asli.
#
# Wajib: isi semua nilai bertanda <...>. Placeholder = app tidak akan start.
#
# Checklist go-live: docs/PRODUCTION_DATABASE.md
# Verifikasi DB:      node scripts/verify-atlas.mjs
# Migrasi DB:         node scripts/migrate-atlas.mjs
# ============================================================

# --- Runtime ---
NODE_ENV=production
PORT=5000

# ============================================================
# DATABASE (MongoDB Atlas — WAJIB eksternal untuk produksi)
# ============================================================
# Atlas SRV. Kredensial WAJIB user khusus produksi (bukan user dev).
# Buat di: Atlas Console → Database Access → Add New Database User
#   role:  Atlas admin (atau readWrite@journal_trade_prod + readWrite@admin)
#   scope: Network Access → allow host produksi (jangan 0.0.0.0/0 untuk long term)
#
# Nama database produksi: journal_trade_prod  (JANGAN pakai journal_trade_dev)
DATABASE_URL=mongodb+srv://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<CLUSTER>.mongodb.net/journal_trade_prod?retryWrites=true&w=majority&appName=JournalTradeProd
DATABASE_NAME=journal_trade_prod

# --- PostgreSQL agent memory (jika dipakai) ---
# Produksi: managed Postgres (RDS/Cloud SQL/Supabase), bukan localhost.
DATABASE_URL_AGENT=postgresql://<USER>:<PASSWORD>@<HOST>:5432/agent_db?schema=public

# ============================================================
# ENKRIPSI (WAJIB di produksi — tanpa ini app menolak start)
# ============================================================
# Kunci dipakai untuk credential at rest (password broker MT5, API key).
# Generate: openssl rand -base64 32
# Rotasi = semua data terenkripsi harus di-decrypt lama lalu encrypt ulang.
ENCRYPTION_KEY=<GENERATE:openssl rand -base64 32 — minimal 32 char>

# ============================================================
# AUTH (Better Auth + Discord OAuth)
# ============================================================
BETTER_AUTH_SECRET=<GENERATE:openssl rand -base64 32>
BETTER_AUTH_URL=https://<DOMAIN_PROD>
FRONTEND_URL=https://<DOMAIN_PROD>

# Discord OAuth — app yang sama dengan dev TIDAK masalah, tapi
# callback URL di Discord Developer Portal harus ditambah domain produksi.
DISCORD_CLIENT_ID=<DISCORD_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_CLIENT_SECRET>
DISCORD_GUILD_ID=<HUNTER_TRADES_GUILD_ID>

# ============================================================
# AI GATEWAY (9Router) — primary LLM router
# ============================================================
NINE_ROUTER_URL=https://<9ROUTER_HOST>/v1
NINE_ROUTER_API_KEY=<NINE_ROUTER_API_KEY>
NINE_ROUTER_MODEL=free

# --- Provider cadangan (opsional) ---
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_AUTH_TOKEN=<ANTHROPIC_AUTH_TOKEN>
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=anthropic/claude-3-5-haiku-latest
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# MACRO / MARKET DATA API KEYS (opsional)
# ============================================================
FINNHUB_API_KEY=<FINNHUB_API_KEY>
ALPHA_VANTAGE_API_KEY=<ALPHA_VANTAGE_API_KEY>
TWELVE_DATA_API_KEY=<TWELVE_DATA_API_KEY>
FRED_API_KEY=<FRED_API_KEY>
TE_API_KEY=<TE_API_KEY>

# ============================================================
# PAYMENT (Midtrans) — produksi
# ============================================================
MIDTRANS_MERCHANT_ID=<MIDTRANS_MERCHANT_ID>
MIDTRANS_CLIENT_KEY=<MIDTRANS_CLIENT_KEY_PROD>
MIDTRANS_SERVER_KEY=<MIDTRANS_SERVER_KEY_PROD>
MIDTRANS_ENV=production
MIDTRANS_CALLBACK_URL=https://<DOMAIN_PROD>/api/payment/callback

# ============================================================
# MT5 MCP (native MetaTrader 5)
# ============================================================
MT5_MCP_URL=http://127.0.0.1:22346/mcp
MT5_MCP_API_KEY=

# ============================================================
# MONITORING & ALERTING
# ============================================================
MONITOR_ALERT_WEBHOOK=<DISCORD_WEBHOOK_URL>
INTERNAL_WS_TOKEN=<GENERATE:openssl rand -base64 32>

# ============================================================
# CATATAN OPERASIONAL
# ============================================================
# 1. Database Name di produksi WAJIB `journal_trade_prod`.
# 2. Setelah deploy DB, jalankan:  node scripts/migrate-atlas.mjs
# 3. Verifikasi:                node scripts/verify-atlas.mjs
# 4. Atlas Backup & failover wajib diaktifkan dari Atlas Console
#    (tidak bisa dari kode — lihat docs/PRODUCTION_DATABASE.md).
# 5. DNS: Atlas SRV butuh resolver publik. App sudah set dns.setServers()
#    di server/src/db/mongoose.ts. Jangan dihapus.
