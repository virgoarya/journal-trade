{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsc *)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git add *:*)",
      "Bash(git commit:*)",
      "Bash(git commit *:*)",
      "Bash(git push:*)",
      "Bash(powershell *:* )",
      "Bash(pkill:*)",
      "Bash(pkill -*:*)",
      "Bash(curl:*)",
      "Bash(curl *:*)",
      "Bash(node *:*)",
      "Bash(node --*:*)"
    ],
    "deny": [
      "file:./.env",
      "file:.env*",
      "file:./.env.local",
      "file:./.env.*.local",
      "file:./.kilo/**",
      "file:./node_modules/**",
      "file:./server/node_modules/**",
      "file:./frontend/node_modules/**"
    ],
    "defaultMode": "manual"
  }
}